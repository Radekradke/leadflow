# ============================================================
#  LeadFlow Imobiliário — variáveis de ambiente (exemplo)
#  Copie para .env e preencha. NUNCA commite o .env real.
# ============================================================

# ── BANCO DE DADOS (Supabase) ────────────────────────────────
# No Supabase (Project Settings > Database) existem DUAS strings de
# conexão diferentes — use a certa em cada variável, senão migrations
# quebram ou o pool esgota rápido sob carga:
#
# DATABASE_URL: conexão DIRETA/sessão (porta 5432, host db.<ref>.supabase.co).
#   Só pra migrations/seed/plano de plataforma. Migrations usam advisory
#   lock (DDL) — não combinam com pool de transação.
DATABASE_URL="postgresql://owner:senha@localhost:5432/leadflow?schema=public"

# APP_DATABASE_URL: pooler SUPAVISOR em modo TRANSAÇÃO (porta 6543, host
#   aws-0-<region>.pooler.supabase.com), role leadflow_app (sem BYPASSRLS).
#   Precisa de "?pgbouncer=true&connection_limit=20": a extensão de RLS
#   (tenant-rls.extension.ts) faz SET_CONFIG com is_local=true — escopado
#   à transação — por isso é compatível com pool de transação.
#
#   ATENÇÃO com connection_limit baixo: testamos com 5 e o throughput sob
#   carga (50 conexões simultâneas, scripts/load-test.ts) foi de só 13
#   req/s (p50 1.8s, p95 6.3s) e 32/50 leads de uma rajada de webhook se
#   perderam (worker sem conexão livre pra processar, competindo pelo
#   mesmo pool pequeno). Com connection_limit=20: 2.834 req/s, p50 10ms,
#   p95 22ms, 0 leads perdidos. Não assuma "pool pequeno é mais seguro"
#   aqui — meça. Reajuste esse número se o teste de carga mudar de
#   resultado (mais usuários, mais réplicas, etc.).
APP_DATABASE_URL="postgresql://leadflow_app:senha@localhost:5432/leadflow?schema=public&pgbouncer=true&connection_limit=20"

# ── AUTENTICAÇÃO ────────────────────────────────────────────
# Segredo do access token (JWT). Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET="troque-por-um-segredo-longo-e-aleatorio"
# Validade do access token. Curto de propósito (o refresh renova).
JWT_ACCESS_TTL="15m"

# ── HTTP / CORS ─────────────────────────────────────────────
# Origem exata do frontend. NUNCA use "*" com cookies de credencial.
FRONTEND_ORIGIN="http://localhost:5173"
# SameSite dos cookies de sessão:
#   "lax"  em dev e quando front/back compartilham domínio (subdomínios).
#   "none" quando front e back estão em domínios DIFERENTES (ex.: Vercel +
#          Render). Exige HTTPS. Mantenha "lax" em desenvolvimento.
COOKIE_SAMESITE="lax"
PORT="3000"
NODE_ENV="development"

# ── SEED ────────────────────────────────────────────────────
# Em produção (NODE_ENV=production) estes são OBRIGATÓRIOS — o seed
# falha se faltarem, para nunca subir senha de DEV por acidente.
PLATFORM_ADMIN_EMAIL="owner@leadflow.local"
PLATFORM_ADMIN_PASSWORD="troque-por-uma-senha-forte"
DEMO_ADMIN_EMAIL="admin@demo.local"
DEMO_ADMIN_PASSWORD="troque-por-uma-senha-forte"

# ── E-MAIL (reset de senha) ─────────────────────────────────
# "console" (padrão em dev): o link de reset é impresso no log do
# servidor — copie e cole no navegador. Em produção, troque por um
# provedor real (Resend/SES/SMTP) implementando o MailService.
MAIL_TRANSPORT="console"
# Para enviar e-mail de verdade em produção: MAIL_TRANSPORT="resend"
# e preencha as duas abaixo (remetente precisa ser de domínio verificado).
RESEND_API_KEY=""
MAIL_FROM="LeadFlow <no-reply@seudominio.com>"

# ───────────── WhatsApp (Cloud API oficial da Meta) ─────────────
# App ÚNICO do SaaS. Pegue no painel de desenvolvedor da Meta.
# Token de verificação do webhook (você inventa; o mesmo no painel da Meta):
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App Secret do app Meta (valida a assinatura dos eventos recebidos):
WHATSAPP_APP_SECRET=""
# Chave p/ criptografar os tokens das contas no banco (32 bytes).
# Gere com:  openssl rand -hex 32
WHATSAPP_ENC_KEY=""
# Versão da Graph API (opcional; default v21.0):
GRAPH_API_VERSION="v21.0"
# Modo simulação: "true" para testar o fluxo capturar→responder SEM a Meta
# (o envio não chama a Graph API; entra o botão "Simular lead" no Atendimento).
# Deixe "false"/vazio em produção.
WHATSAPP_DEV_MODE="false"

# ───────────── Fila (pgmq) ─────────────
# Habilite a extensão "pgmq" no painel do Supabase (Database > Extensions)
# antes de rodar as migrations — CREATE EXTENSION exige privilégio que o
# app não tem por padrão.
# Intervalo do polling do worker (ms). 2000 é generoso pra 50 usuários;
# baixe se a latência de entrega da mensagem/lead importar mais que custo.
QUEUE_POLL_INTERVAL_MS="2000"
# Tempo (s) que uma mensagem lida fica invisível antes de voltar pra fila
# se ninguém confirmar (worker caiu no meio) — é o retry automático.
QUEUE_VISIBILITY_TIMEOUT_SECONDS="30"
# "false" quando o worker for um serviço separado (Render Background
# Worker rodando `node dist/worker.js`); default "true" roda o worker
# dentro do mesmo processo da API (milestone 1, um serviço só).
RUN_QUEUE_WORKER_IN_PROCESS="true"
